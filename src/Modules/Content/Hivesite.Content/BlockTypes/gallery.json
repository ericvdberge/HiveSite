{
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "attrs"],
  "properties": {
    "type": { "const": "gallery" },
    "attrs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["images"],
      "properties": {
        "heading": { "$ref": "#/$defs/heading", "default": "" },
        "images": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url", "alt"],
            "properties": {
              "url": { "$ref": "#/$defs/url" },
              "alt": { "type": "string", "maxLength": 200 },
              "caption": { "type": "string", "maxLength": 200, "default": "" }
            }
          }
        },
        "columns": { "type": "integer", "minimum": 2, "maximum": 4, "default": 3 }
      }
    }
  }
}
