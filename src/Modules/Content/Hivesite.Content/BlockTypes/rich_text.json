{
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "content"],
  "properties": {
    "type": { "const": "rich_text" },
    "content": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/paragraph" },
          { "$ref": "#/$defs/heading_node" },
          { "$ref": "#/$defs/bullet_list" },
          { "$ref": "#/$defs/ordered_list" }
        ]
      }
    }
  }
}
