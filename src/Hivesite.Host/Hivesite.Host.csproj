<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- dotnet build writes the public OpenAPI document to openapi/hivesite.json (git-ignored). Never edit or commit it. -->
    <OpenApiDocumentsDirectory>$(MSBuildThisFileDirectory)../../openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name hivesite</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hivesite.Shared\Hivesite.Shared.csproj" />
    <ProjectReference Include="..\Modules\Content\Hivesite.Content\Hivesite.Content.csproj" />
    <ProjectReference Include="..\Modules\Rendering\Hivesite.Rendering\Hivesite.Rendering.csproj" />
    <ProjectReference Include="..\Modules\Publishing\Hivesite.Publishing\Hivesite.Publishing.csproj" />
  </ItemGroup>
</Project>
